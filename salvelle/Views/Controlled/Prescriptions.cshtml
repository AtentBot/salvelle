@using Models
@model List<SpecialPrescriptionControl>
@{
    ViewData["Title"] = "Receituários - Controlados";
    var selectedType = ViewBag.SelectedType as string ?? "";
    var startDate = ViewBag.StartDate as DateTime?;
    var endDate = ViewBag.EndDate as DateTime?;
}

@section Styles {
<style>
    .ds-card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-md); overflow: hidden; }
    .ds-card.pad { padding: 20px; }
    .ds-card-head { padding: 16px 20px; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .ds-card-eyebrow { font-family: var(--font-mono); font-size: 11px; color: var(--petrol-500); margin-bottom: 4px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }
    .ds-card-title { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; margin: 0; }

    .filter-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr auto; gap: 12px; align-items: end; }
    .filter-actions { display: flex; gap: 8px; }

    .empty-row { text-align: center; color: var(--ink-3); padding: 48px 24px; }
    .empty-row i { font-size: 32px; display: block; margin-bottom: 8px; color: var(--ink-5); }

    @@media (max-width: 900px) {
        .filter-grid { grid-template-columns: 1fr 1fr; }
        .filter-actions { grid-column: 1 / -1; }
        .filter-actions .btn { flex: 1; justify-content: center; }
    }
    @@media (max-width: 780px) {
        table.responsive-stack thead { display: none; }
        table.responsive-stack tbody tr { display: block; border-bottom: 1px solid var(--rule); padding: 12px 16px; }
        table.responsive-stack tbody tr:hover td { background: transparent; }
        table.responsive-stack tbody td { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 5px 0; border: none; text-align: right; }
        table.responsive-stack tbody td::before { content: attr(data-label); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-3); font-weight: 500; text-align: left; }
    }
    @@media (max-width: 520px) {
        .filter-grid { grid-template-columns: 1fr; }
    }
</style>
}

<div>
    <div class="page-head">
        <div>
            <div class="eyebrow" style="margin-bottom:6px;">SNGPC · RECEITUÁRIOS</div>
            <h1>Receituários de Controlados</h1>
            <p>Controle de receitas especiais conforme Portaria 344/98.</p>
        </div>
        <div class="row">
            <a class="btn btn-secondary" href="/Controlled"><i class="bi bi-arrow-left"></i>Voltar</a>
        </div>
    </div>

    <div class="ds-card pad" style="margin-bottom:24px;">
        <form method="get" class="filter-grid">
            <div>
                <label class="input-label">Tipo de receita</label>
                <select name="type" class="select">
                    <option value="">Todas</option>
                    @if (selectedType == "AMARELA")
                    {
                        <option value="AMARELA" selected>Amarela (A1/A2/A3)</option>
                        <option value="AZUL">Azul (B1/B2)</option>
                        <option value="BRANCA_2_VIAS">Branca 2 vias (C1/C2/C5)</option>
                    }
                    else if (selectedType == "AZUL")
                    {
                        <option value="AMARELA">Amarela (A1/A2/A3)</option>
                        <option value="AZUL" selected>Azul (B1/B2)</option>
                        <option value="BRANCA_2_VIAS">Branca 2 vias (C1/C2/C5)</option>
                    }
                    else if (selectedType == "BRANCA_2_VIAS")
                    {
                        <option value="AMARELA">Amarela (A1/A2/A3)</option>
                        <option value="AZUL">Azul (B1/B2)</option>
                        <option value="BRANCA_2_VIAS" selected>Branca 2 vias (C1/C2/C5)</option>
                    }
                    else
                    {
                        <option value="AMARELA">Amarela (A1/A2/A3)</option>
                        <option value="AZUL">Azul (B1/B2)</option>
                        <option value="BRANCA_2_VIAS">Branca 2 vias (C1/C2/C5)</option>
                    }
                </select>
            </div>
            <div>
                <label class="input-label">Data início</label>
                <input type="date" name="startDate" class="input" value="@(startDate?.ToString("yyyy-MM-dd"))">
            </div>
            <div>
                <label class="input-label">Data fim</label>
                <input type="date" name="endDate" class="input" value="@(endDate?.ToString("yyyy-MM-dd"))">
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i>Filtrar</button>
                <a href="/Controlled/Prescriptions" class="btn btn-secondary"><i class="bi bi-x-circle"></i>Limpar</a>
            </div>
        </form>
    </div>

    <div class="ds-card">
        <div class="ds-card-head">
            <div>
                <div class="ds-card-eyebrow">Receitas especiais</div>
                <h3 class="ds-card-title">Receituários registrados</h3>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table responsive-stack mb-0">
                <thead>
                    <tr>
                        <th>Emissão</th>
                        <th>Tipo</th>
                        <th>Nº Receita</th>
                        <th>Paciente</th>
                        <th>Prescritor</th>
                        <th>Validade</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var rx in Model)
                        {
                            var typeBadge = "badge-neutral";
                            if (rx.PrescriptionType == "AMARELA") typeBadge = "badge-warn";
                            else if (rx.PrescriptionType == "AZUL") typeBadge = "badge-info";
                            else if (rx.PrescriptionType == "BRANCA_2_VIAS") typeBadge = "badge-neutral";

                            var statusBadge = "badge-neutral";
                            if (rx.Status == "ATIVA") { statusBadge = "badge-ok"; }
                            else if (rx.Status == "UTILIZADA") { statusBadge = "badge-petrol"; }
                            else if (rx.Status == "VENCIDA") { statusBadge = "badge-danger"; }
                            else if (rx.Status == "CANCELADA") { statusBadge = "badge-neutral"; }

                            var isExpiring = rx.Status == "ATIVA" && rx.ValidityDate <= DateTime.Today.AddDays(7);

                            <tr>
                                <td data-label="Emissão" class="mono">@rx.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td data-label="Tipo"><span class="badge @typeBadge badge-no-dot">@rx.PrescriptionType</span></td>
                                <td data-label="Nº Receita" class="mono">@rx.PrescriptionNumber</td>
                                <td data-label="Paciente" style="color:var(--ink);font-weight:500;">@rx.PatientName</td>
                                <td data-label="Prescritor">
                                    @rx.DoctorName
                                    <br><small style="color:var(--ink-3);">CRM @rx.DoctorCrm/@rx.DoctorCrmState</small>
                                </td>
                                <td data-label="Validade" class="mono">
                                    @rx.ValidityDate.ToString("dd/MM/yyyy")
                                    @if (isExpiring)
                                    {
                                        <br><small style="color:var(--danger);"><i class="bi bi-exclamation-triangle"></i> Vencendo</small>
                                    }
                                </td>
                                <td data-label="Status"><span class="badge @statusBadge badge-no-dot">@rx.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-row">
                                <i class="bi bi-inbox"></i>
                                Nenhuma receita encontrada.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
