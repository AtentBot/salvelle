@{
    ViewData["Title"] = "Receber Mercadoria";
    var orderId = ViewBag.OrderId;
}

@section Styles {
<style>
    .ds-card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-md); overflow: hidden; margin-bottom: 20px; }
    .ds-card-head { padding: 14px 20px; border-bottom: 1px solid var(--rule); display: flex; align-items: center; gap: 8px; }
    .ds-card-title { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; margin: 0; display: flex; align-items: center; gap: 8px; }
    .ds-card-title i { color: var(--petrol-500); }
    .ds-card-body { padding: 18px 20px; }

    .info-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .info-field strong { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-3); font-weight: 500; margin-bottom: 3px; }
    .info-field p { margin: 0; font-size: 14px; color: var(--ink); font-weight: 500; }

    .recv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

    /* Bootstrap → design system (form fields estáticos e injetados via JS) */
    .form-label { font-size: 12px; font-weight: 500; color: var(--ink-2); margin-bottom: 4px; }
    .form-control, .form-select {
        border: 1px solid var(--rule); border-radius: var(--r-sm); font-size: 14px;
        background: var(--surface); color: var(--ink); padding: 8px 11px;
    }
    .form-control:focus, .form-select:focus { border-color: var(--petrol-500); box-shadow: 0 0 0 3px var(--petrol-50); outline: none; }
    .form-control::placeholder { color: var(--ink-5); }

    /* Cards de item injetados pelo receive.js */
    .item-card { border: 1px solid var(--rule); border-radius: var(--r-md); padding: 1.25rem; margin-bottom: 1rem; background-color: var(--surface); }
    .item-card.completed { background-color: var(--ok-soft); border-color: var(--ok-border); }
    .item-header { font-weight: 600; font-size: 1rem; margin-bottom: 1rem; color: var(--ink); display: flex; justify-content: space-between; align-items: center; }
    .item-header .text-muted { color: var(--ink-3) !important; font-weight: 400; }
    .batch-info { background-color: var(--bg-subtle); border: 1px solid var(--rule); border-radius: var(--r-sm); padding: 1rem; margin-top: 1rem; }

    @@media (max-width: 780px) { .info-grid { grid-template-columns: 1fr 1fr; } .recv-grid { grid-template-columns: 1fr; } }
</style>
}

<div>
    <div class="page-head">
        <div>
            <div class="eyebrow" style="margin-bottom:6px;">COMPRAS · RECEBIMENTO</div>
            <h1>Receber mercadoria</h1>
            <p>Confirme quantidades e registre os lotes recebidos no estoque.</p>
        </div>
        <div class="row">
            <a href="/compras/@orderId" class="btn btn-secondary"><i class="bi bi-arrow-left"></i>Voltar</a>
        </div>
    </div>

    <div id="loadingOrder" class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width:1.8rem;height:1.8rem;">
            <span class="visually-hidden">Carregando...</span>
        </div>
    </div>

    <form id="formReceiveOrder" style="display:none;">
        <div class="ds-card">
            <div class="ds-card-head">
                <h5 class="ds-card-title"><i class="bi bi-info-circle"></i>Informações do pedido</h5>
            </div>
            <div class="ds-card-body">
                <div class="info-grid">
                    <div class="info-field"><strong>Nº pedido</strong><p id="orderNumber"></p></div>
                    <div class="info-field"><strong>Fornecedor</strong><p id="supplierName"></p></div>
                    <div class="info-field"><strong>Data do pedido</strong><p id="orderDate"></p></div>
                    <div class="info-field"><strong>Valor total</strong><p id="totalValue" style="color:var(--ok);font-weight:600;"></p></div>
                </div>
            </div>
        </div>

        <div class="ds-card">
            <div class="ds-card-head">
                <h5 class="ds-card-title"><i class="bi bi-clipboard-check"></i>Dados do recebimento</h5>
            </div>
            <div class="ds-card-body">
                <div class="recv-grid">
                    <div>
                        <label for="actualDeliveryDate" class="input-label">Data de recebimento *</label>
                        <input type="datetime-local" id="actualDeliveryDate" name="actualDeliveryDate" class="input" required>
                    </div>
                    <div>
                        <label for="supplierInvoiceNumber" class="input-label">Número da nota fiscal</label>
                        <input type="text" id="supplierInvoiceNumber" name="supplierInvoiceNumber" class="input" maxlength="100">
                    </div>
                </div>
            </div>
        </div>

        <div class="ds-card">
            <div class="ds-card-head">
                <h5 class="ds-card-title"><i class="bi bi-box-seam"></i>Itens para receber</h5>
            </div>
            <div class="ds-card-body">
                <div id="itemsContainer"></div>
            </div>
        </div>

        <div class="row" style="gap:12px;">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i>Confirmar recebimento</button>
            <a href="/compras/@orderId" class="btn btn-secondary"><i class="bi bi-x-circle"></i>Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/purchase-orders-receive.js"></script>
    <script>
        $(document).ready(function() {
            PurchaseOrdersReceive.init(@orderId);
        });
    </script>
}
